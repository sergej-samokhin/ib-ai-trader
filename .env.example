# Copy to .env (git-ignored). Environment variables override values in this file.

# --- Mode -------------------------------------------------------------------------
# Paper unless set to exactly "live".
MODE=paper

# --- IBKR -------------------------------------------------------------------------
IB_HOST=127.0.0.1
# IB Gateway: 4002 paper / 4001 live. TWS: 7497 paper / 7496 live.
IB_PORT=4002
IB_CLIENT_ID=17
# Paper accounts start with DU. Required for MODE=live.
IB_ACCOUNT=
# 1 = live data (needs subscriptions), 3 = delayed
MARKET_DATA_TYPE=1

# --- Storage / producers ----------------------------------------------------------
DATA_DIR=var
PRODUCERS_FILE=config/producers.yaml

# --- Ingestion --------------------------------------------------------------------
FILE_DROP_ENABLED=true
HTTP_ENABLED=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
MAX_SIGNAL_BYTES=65536

# --- Global risk limits (placeholders - set your own; signals can never exceed them) ---
MAX_POSITION_USD=500
MAX_PORTFOLIO_RISK_USD=2000
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_USD=300
# Net realised P&L per calendar month (New York); open premium counts as possible loss
MAX_MONTHLY_LOSS_USD=3000
MAX_UNDERLYING_EXPOSURE_USD=1000
MIN_OPEN_INTEREST=100
MAX_BID_ASK_SPREAD_PCT=10
NO_ENTRY_OPEN_MINUTES=15
NO_ENTRY_CLOSE_MINUTES=15
MANUAL_APPROVAL_ABOVE_USD=400
MIN_CONFIDENCE_AUTO=0.0
APPROVAL_TIMEOUT_MINUTES=30
MAX_DELTA_DEVIATION=0.10

# --- Loop / orders ----------------------------------------------------------------
LOOP_INTERVAL_SECONDS=5
REPRICE_INTERVAL_SECONDS=20
RULE_EVAL_INTERVAL_SECONDS=300
PRICE_TICK=0.05
EXIT_MAX_REPRICE_STEPS=5
DAILY_SUMMARY_TIME=16:15

# --- Notifications (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
